# Chunk Generator - Groq como LLM padrao (custo zero)
# Copie: copy .env.example .env

# Chave unica (ou use GROQ_KEY_1..10 para Load Balancer)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Multiplas chaves para transcricao/limpeza em massa (rotacao itertools.cycle)
# Em 429: chave desativada 60s, proxima usada automaticamente
# GROQ_KEY_1=gsk_xxx
# GROQ_KEY_2=gsk_xxx
# ... GROQ_KEY_10=gsk_xxx

# Modelo Groq (opcional): llama-3.3-70b-versatile ou mixtral-8x7b-32768
# LLM_MODEL=llama-3.3-70b-versatile

# Embeddings ChromaDB: OpenAI (se tiver) ou all-MiniLM-L6-v2 local
# OPENAI_API_KEY=sk-proj-xxx

# Web Extractor (Selenium) - extração automática de API Keys
# EXTRACTOR_URL=https://console.groq.com
# EXTRACTOR_USER=seu_email@exemplo.com
# EXTRACTOR_PASS=sua_senha
# EXTRACTOR_HEADLESS=true
# EXTRACTOR_KEYS_URL=https://console.groq.com/keys
# EXTRACTOR_CHROME_USER_DATA=C:\Users\...\AppData\Local\Google\Chrome\User Data
# EXTRACTOR_CHROME_PROFILE=Default  # Ou Profile 1, Profile 2, etc.
# EXTRACTOR_GOOGLE_EMAIL=seu_email@gmail.com  # Verificar sessao no Google Groups
# EXTRACTOR_GOOGLE_USER=email@gmail.com  # Login Google (access-error). Fallback: EXTRACTOR_USER
# EXTRACTOR_GOOGLE_PASS=senha  # Senha Google. Fallback: EXTRACTOR_PASS
# EXTRACTOR_GOOGLE_GROUP_NAME=Nome do Seu Grupo  # Nome parcial para PARTIAL_LINK_TEXT
# EXTRACTOR_GROUP_EMAIL_PREFIX=groq-test-implementation  # Base do email (gera groq-test-implementation-k7f2@googlegroups.com, sufixo aleatorio a cada rodada)
# EXTRACTOR_USE_IDENTITY_JUMP=true  # Fluxo simples: Google->GitHub->Groq
# EXTRACTOR_USE_ROTATING_IDENTITY=false  # Fluxo completo: Groups->Gmail->GitHub->Groq
# EXTRACTOR_NEW_EMAIL=novo_email@gmail.com  # Email para encaminhamento (Identidade Rotativa)
# EXTRACTOR_GOOGLE_GROUP_URL=https://groups.google.com/g/seu-grupo  # URL direta (evita buscar na lista). Ex: /g/inteligencias-do-pai
# EXTRACTOR_GMAIL_WAIT_SECONDS=120  # Espera maxima para email de confirmacao
# EXTRACTOR_GMAIL_SEARCH=confirma OR verification  # Busca no Gmail
# EXTRACTOR_GMAIL_MANUAL_WAIT=30  # Segundos se precisar intervencao manual

# Retry e Logging
# RETRY_MAX_ATTEMPTS=3
# RETRY_BACKOFF_FACTOR=2
# LOG_LEVEL=INFO
# LOG_FILE=logs/extractor.log

# Supabase - Gestão centralizada de API Keys
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=eyJxxx
# SUPABASE_TABLE=api_keys

# Telegram Bot - Agentes RAG (Marketing, Social, Analytics)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# AUTHORIZED_CHAT_ID=123456789
# TELEGRAM_GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# Neo4j Graph Database
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
# NEO4J_DATABASE=neo4j

# ============================================
# Gemini API (fallback LLM)
# ============================================
# GEMINI_API_KEY=your_gemini_api_key

# ============================================
# Claude API (fallback LLM)
# ============================================
# CLAUDE_API_KEY=your_claude_api_key

# ============================================
# n8n Workflow Engine
# ============================================
# N8N_HOST=http://localhost:5678
# N8N_API_KEY=your_n8n_api_key

# ============================================
# Sovereign Gateway
# ============================================
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8766

# ============================================
# Sentinela Monitor - Missão 002
# ============================================

# Neo4j Log Monitoring
NEO4J_LOG_PATH=./logs/neo4j.log
POLL_INTERVAL=2.0

# Visual Detection
TEMPLATES_DIR=./templates
CONFIDENCE_THRESHOLD=0.85

# Dashboard
DASHBOARD_URL=http://localhost:3000
PAGE_LOAD_TIMEOUT=30.0
SCREENSHOT_INTERVAL=0.5

# Error Handling
MAX_RETRIES=3
RETRY_DELAY=5.0

# Logging
LOG_LEVEL=INFO
